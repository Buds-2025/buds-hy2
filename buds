                read -rp '输入 auto、ipv4 或 ipv6（更改需要短暂重启 WARP，回车返回）: ' profile || return 0
                if [[ -n "$profile" ]]; then warp_manage gemini-family "$profile" || true; fi
                ;;
            5)
                read -rp '关闭后所有节点的目标域名都将回到原有出口。确认关闭？[y/N] ' confirm || return 0
                if [[ "${confirm,,}" == y ]]; then warp_manage disable || echo "关闭未完成，请参照上方提示。"
                else echo '已取消关闭。'; fi ;;
            6) warp_manage doctor || true ;;
            7) warp_manage status || true ;;
            8) warp_manage setup || echo "准备依赖未完成，请参照上方提示。" ;;
            9) warp_manage setup --managed-core || echo "独立内核准备未完成，请参照上方提示。" ;;
            10) echo '已有可用的专用配置时会沿用它。需要注册时会提示确认。'
               warp_manage setup --new-profile || echo '配置未就绪，请查看上方提示。' ;;
            11|12)
                if [[ "$choice" == 11 ]]; then
                    read -rp "迁移系统 DNS 到本机存根，会短暂重启解析服务。确认？[y/N] " confirm || return 0
                    if [[ "${confirm,,}" == y ]]; then
                        warp_manage dns-switch || echo "DNS 迁移未完成，请参照上方提示。"
                    else
                        echo "已取消 DNS 迁移。"
                    fi
                else
                    read -rp "恢复迁移前的 DNS，会短暂重启解析服务。确认？[y/N] " confirm || return 0
                    if [[ "${confirm,,}" == y ]]; then
                        warp_manage dns-restore || echo "DNS 恢复未完成，请参照上方提示。"
                    else
                        echo "已取消 DNS 恢复。"
                    fi
                fi
                ;;
            13)
                read -rp "输入服务器上的 WireGuard .conf 路径；已有配置直接回车自动查找： " profile || return 0
                warp_manage enable "$profile" || echo "启用未完成，可选择 6 查看启用条件。"
                ;;
            14)
                read -rp '修复会更新托管文件，必要时重启 WARP，已有分流连接可能中断。继续？[y/N] ' confirm || return 0
                if [[ "${confirm,,}" == y ]]; then warp_manage repair || echo "修复未完成，请查看上方诊断。"; fi ;;
            15)
                if nodes_manage reserve-ports; then
                    if [[ -d "$WARP_DIR" ]]; then warp_manage refresh || echo "分流保护文件刷新失败。"
                    else echo "已检查节点端口。WARP 尚未启用。"; fi
                else echo "源端口保护检查失败，请处理上方提示后重试。"; fi ;;
            0|"") return 0 ;;
            *) echo "请输入 B 区的 1–15，或输入 0 返回首页。" ;;
        esac
        panel_pause 'B 区' || return 0
    done
}

show_menu() {
    local remote_ver choice width
    remote_ver=$(check_remote_version 2>/dev/null) || remote_ver=""
    while true; do
        local status_badge domain listen has_update
        local is_running=false
        if has_systemd; then
            if systemctl is-active --quiet hysteria-server 2>/dev/null; then
                is_running=true
            fi
        elif has_openrc; then
            if rc-service hysteria-server status 2>/dev/null | grep -q "started"; then
                is_running=true
            fi
        else
            if pgrep -fx "$PROCESS_PATTERN" >/dev/null 2>&1; then
                is_running=true
            fi
        fi

        if [[ "$is_running" == "true" ]]; then
            status_badge="${C_GREEN}● 运行中${C_RESET}"
        else
            status_badge="${C_RED}● 已停止${C_RESET}"
        fi

        domain=$(get_domain)
        listen=$(get_listen)
        [[ -z "$listen" ]] && listen="未配置"
        has_update=false
        if is_version_newer "$remote_ver" "$SCRIPT_VERSION"; then
            has_update=true
        fi

        panel_clear
        width=$(panel_width)
        panel_logo "$width"
        printf '  主节点  %b    UDP  %b%s%b\n' "$status_badge" "$C_CYAN" "$listen" "$C_RESET"
        printf '  域名    %b%s%b' "$C_WHITE" "$domain" "$C_RESET"
        if (( width < 52 )); then printf '\n '; fi
        printf '   混淆  %bSalamander%b\n' "$C_AMBER" "$C_RESET"
        if [[ "$has_update" == "true" ]]; then
            echo -e "  ${C_BAR}  ${C_SPARK}✦ 发现脚本新版本  v${remote_ver} (当前: v${SCRIPT_VERSION})  ▶ 输入 U 即可更新${C_RESET}"
        fi
        panel_section "$C_ORANGE_BOLD" 'A 节点管理'
        nodes_options "$width"
        panel_section "$C_CYAN" 'B WARP 分流管理'
        warp_options "$width"
        printf '  %bU. 更新脚本    0. 退出%b\n' "$C_GRAY_LIGHT" "$C_RESET"
        read -rp '先选区域 [A/B] › ' choice || return 0
        case "${choice^^}" in
            A) nodes_menu; continue ;;
            B) warp_menu; continue ;;
            U)
                if update_script && [[ -x "$BUDS_CLI" ]]; then
                    panel_pause '首页' || return 0
                    exec "$BUDS_CLI" hy2
                fi ;;
            0) return 0 ;;
            *) echo '请先输入 A 或 B 进入对应区域，再输入该区的编号。' ;;
        esac
        panel_pause '首页' || return 0
    done
}

