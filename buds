                if update_script; then
                    read -rp "按回车键重新加载主菜单..."
                    if [[ -x "${BUDS_CLI:-/usr/local/bin/buds}" ]]; then
                        exec "${BUDS_CLI:-/usr/local/bin/buds}" hy2
                    fi
                else
                    read -rp "按回车键返回主菜单..."
                fi
                ;;
            9) renew_test || echo -e "  ${C_RED}✖ 证书续签模拟失败，请检查日志。${C_RESET}"; read -rp "按回车键返回主菜单..." ;;
            10) uninstall || true; break ;;
            11)
                warp_manage status || true
                read -rp "启用(e)、关闭(d)、检测(c)、管理域名(m)、返回(回车)： " op
                case "$op" in
                    e) read -rp "WARP WireGuard 配置路径（回车使用 /etc/warp/wgcf-profile.conf）： " profile
                       warp_manage enable "$profile" || true ;;
                    d) warp_manage disable || true ;;
                    c) warp_manage check || true ;;
                    m) warp_domains_menu || true ;;
                esac
                read -rp "按回车键返回主菜单..." ;;
            0) exit 0 ;;
            *) echo "输入无效，请重新选择。" ;;
        esac
