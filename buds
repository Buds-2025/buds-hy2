warp_check_stub() {
    awk '$1=="nameserver" {count++; if ($2!="127.0.0.53") other=1}
         END {exit !(count && !other)}' /etc/resolv.conf ||
        { echo "系统 DNS 必须仅使用 127.0.0.53；混用其他 nameserver 会绕过域名分流。" >&2; return 1; }
}

