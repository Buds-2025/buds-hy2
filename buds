case "$1" in
    _node-firewall)
        CONFIG_DIR=$3
        [[ -d "$CONFIG_DIR" && "$CONFIG_DIR" == */.main-edit-* && "$4" =~ ^[0-9]+(-[0-9]+)?$ ]] || exit 2
        case "$2" in
            open)
                UFW_PORT_RULE="${4//-/:}/udp"
                info() { echo "$*"; }
                warn() { echo "$*" >&2; exit 1; }
                configure_firewall ;;
            close) cleanup_firewall ;;
            *) exit 2 ;;
        esac ;;
    status) status ;;
    log) log ;;
    restart|stop|start|link|client) nodes_manage "$1" main ;;
    warp) shift; warp_manage "$@" ;;
    nodes|node) shift; nodes_manage "$@" ;;
    renew-test) renew_test ;;
    uninstall) uninstall ;;
    update) update_script ;;
    check-update)
        if [[ ! -s "$UPDATE_PUBLIC_KEY" ]]; then
            printf '缺少可信发布公钥 %s，请按 README 安装。\n' "$UPDATE_PUBLIC_KEY" >&2
            exit 1
        fi
        if ! r_ver=$(check_remote_version true); then
            echo "无法获取有效的仓库更新版本，请检查网络、更新分支和签名。" >&2
            exit 1
        fi
        if is_version_newer "$r_ver" "$SCRIPT_VERSION"; then
            echo "新版本可用: v${r_ver} (当前: v${SCRIPT_VERSION})"
            exit 0
        elif is_version_newer "$SCRIPT_VERSION" "$r_ver"; then
            echo "当前脚本 v$SCRIPT_VERSION 高于签名渠道 v$r_ver。"
        else
            echo "已是最新版本: v$SCRIPT_VERSION"
            exit 0
        fi
        ;;
    version|-v|--version)
        echo "buds-hy2 v${SCRIPT_VERSION}"
        exit 0
        ;;
    *) show_menu ;;
esac
