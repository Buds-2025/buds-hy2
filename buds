nodes_tool() {
    BUDS_NODE_CLI="${BASH_SOURCE[0]}" python3 -I -c "$(nodes_source)" "$CONFIG_DIR" "$(get_listen)" "$(get_public_ports)" "$(get_domain)" "$@"
}

nodes_manage() (
    local action=${1:-list} name=${2:-}
    if [[ "$action" == reserve-ports || "$action" == prepare-install-ports ]]; then
        exec 9>/run/buds-hy2-nodes.lock && flock -x 9 || return 1
        nodes_tool "$@"; return
    fi
    if [[ "$name" == main ]]; then
        case "$action" in
            detail) printf '主节点 main · %s · 本地 UDP %s · 公网 UDP %s\n' "$(get_domain)" "$(get_listen)" "$(get_public_ports)"; return ;;
            status) status; return ;;
            log) if has_systemd; then journalctl -u hysteria-server -n 50 --no-pager; else tail -n 50 /var/log/hysteria.log; fi; return ;;
            start|stop|restart|client|link)
                if command -v flock >/dev/null; then exec 9>/run/buds-hy2-nodes.lock && flock -x 9 || return 1; fi
                "$action"; return ;;
        esac
    fi
    if ! has_systemd; then
        case "$action" in
            names) [[ ! -f "$CONFIG_FILE" ]] || echo main; return 0 ;;
            list) [[ ! -f "$CONFIG_FILE" ]] || nodes_manage detail main; return 0 ;;
        esac
        echo "当前系统未使用 systemd。可管理主节点的运行、链接、配置和日志；自动编辑和新增节点需要 systemd。" >&2
        return 1
    fi
    local dependency
    for dependency in python3 flock ss openssl; do
        if ! command -v "$dependency" >/dev/null; then
            echo "多节点管理缺少 $dependency，可先管理主节点或用系统包管理器安装该工具。" >&2
            case "$action" in
                names) [[ ! -f "$CONFIG_FILE" ]] || echo main; return 0 ;;
                list) [[ ! -f "$CONFIG_FILE" ]] || nodes_manage detail main; return 0 ;;
            esac
            return 1
        fi
    done
    exec 9>/run/buds-hy2-nodes.lock || return 1
    if [[ "$action" != quick-add ]]; then flock -x 9 || return 1; fi
    if [[ "$action" == link || "$action" == client ]]; then
        nodes_tool detail "$name" || return 1
        CONFIG_DIR="$CONFIG_DIR/nodes/$name"
        CONFIG_FILE="$CONFIG_DIR/config.yaml"
        CLIENT_CONFIG_FILE="$CONFIG_DIR/client.yaml"
        NODE_LABEL="$name"
        "$action"
    elif (( $# )); then
        nodes_tool "$@"
    else
        nodes_tool list
    fi
)

panel_clear() {
    if [[ -t 1 && "${TERM:-dumb}" != dumb ]]; then printf '\033[H\033[2J'; fi
}

panel_width() {
    local rows width=
    if [[ -t 0 ]]; then
        read -r rows width < <(stty size 2>/dev/null) || width=
    fi
    [[ "$width" =~ ^[1-9][0-9]{0,3}$ ]] || width=${COLUMNS:-80}
    [[ "$width" =~ ^[1-9][0-9]{0,3}$ ]] || width=80
    printf '%s\n' "$width"
}

panel_logo() {
    local width=$1 i
    local -a buds=('█▀▀█ █  █ █▀▀▄ █▀▀▀' '█▀▀▄ █  █ █  █ ▀▀▀█' '█  █ █  █ █  █    █' '▀▀▀▀ ▀▀▀▀ ▀▀▀  ▀▀▀▀')
    local -a hy2=('█  █ █  █ █▀▀█' '█▀▀█ ▀██▀   ▄▀' '█  █   █  ▄▀' '▀  ▀   ▀  ▀▀▀▀')
    if (( width >= 48 )); then
        printf '       %b✧                                      ✦%b\n' "$C_SPARK" "$C_RESET"
    else
        printf '       %b✧    ✦%b\n' "$C_SPARK" "$C_RESET"
    fi
    if (( width >= 38 )); then
        for i in "${!buds[@]}"; do
            printf '  %b%s%b   %b%s%b\n' "$C_ORANGE_BOLD" "${buds[i]}" "$C_RESET" "$C_GRAY_LIGHT" "${hy2[i]}" "$C_RESET"
        done
    else
        printf "  ${C_ORANGE_BOLD}%s${C_RESET}\n" "${buds[@]}"
        printf "  ${C_GRAY_LIGHT}%s${C_RESET}\n" "${hy2[@]}"
    fi
    if (( width >= 52 )); then
        printf '  %bHysteria 2 High-Performance Protocol Suite%b  %bv%s%b\n' "$C_GRAY_LIGHT" "$C_RESET" "$C_CYAN" "$SCRIPT_VERSION" "$C_RESET"
    else
        printf '  %bHysteria 2%b  %bv%s%b\n' "$C_GRAY_LIGHT" "$C_RESET" "$C_CYAN" "$SCRIPT_VERSION" "$C_RESET"
    fi
}

panel_section() {
    printf '\n%b▌ %s%b\n' "$1" "$2" "$C_RESET"
}

panel_choices() {
    local accent=$1 width=$2 count=1 index=0 label non_ascii cells
    shift 2
    local LC_ALL=C
    if (( width >= 80 )); then count=3
    elif (( width >= 52 )); then count=2; fi
    for label in "$@"; do
        index=$((index + 1))
        printf ' %b%2d.%b %s' "$accent" "$index" "$C_RESET" "$label"
        if (( index % count == 0 || index == $# )); then
            printf '\n'
        else
            # 当前选项只有 ASCII 和三字节中文字符；中文在终端占两格。
            non_ascii=${label//[[:print:]]/}
            cells=$(( ${#label} - ${#non_ascii} / 3 ))
            printf '%*s' "$((21 - cells))" ''
        fi
    done
}

panel_pause() {
    if [[ -t 0 && -t 1 ]]; then
        local key
        printf '\n'
        IFS= read -rp "按回车返回$1… " key
    fi
}

nodes_quick_add() {
    local name rc
    printf '\nHysteria 2 新节点安装\n\n'
    while true; do
        read -rp '节点名称（回车自动，输入 0 取消）：' name || return 0
        if [[ "$name" == 0 ]]; then return 0; fi
        name=${name:-node-$(date +%m%d%H%M%S)-$RANDOM}
        if [[ ! "$name" =~ ^[a-z0-9][a-z0-9_-]{0,30}$ || "$name" == main ]]; then
            echo '请输入 1–31 位小写字母、数字、下划线或短横线，名称以字母或数字开头。'
            continue
        fi
        if nodes_manage quick-add "$name"; then break; else rc=$?; fi
        if (( rc != 3 )); then return "$rc"; fi
    done
    nodes_manage link "$name" || printf '节点已启动。可在节点菜单重新查看 %s 的连接链接。\n' "$name"
}

nodes_edit_menu() {
    local name=$1 choice flag value prompt confirm
    local -a packages
    if [[ "$name" == main ]] && has_systemd && command -v python3 >/dev/null && ! python3 -I -c 'import yaml' 2>/dev/null; then
        if command -v apt-get >/dev/null; then packages=(apt-get install -y python3-yaml)
        elif command -v dnf >/dev/null; then packages=(dnf install -y python3-pyyaml)
        elif command -v yum >/dev/null; then packages=(yum install -y python3-pyyaml)
        elif command -v pacman >/dev/null; then packages=(pacman -S --needed --noconfirm python-yaml)
        else echo '编辑主节点需要系统 Python 3 的 PyYAML 包。'; panel_pause 'A 区' || true; return 0; fi
        echo "编辑主节点需要 PyYAML 读取现有配置。将执行：${packages[*]}"
        read -rp '现在安装此依赖？[y/N] ' confirm || return 0
        [[ "${confirm,,}" == y ]] || return 0
        if ! "${packages[@]}" || ! python3 -I -c 'import yaml'; then
            echo '依赖尚未就绪，请核对软件源后重试。'; panel_pause 'A 区' || true; return 0
        fi
    fi
    while true; do
        panel_clear
        printf '\n编辑节点 %s\n\n' "$name"
        if ! nodes_manage detail "$name"; then panel_pause 'A 区' || true; return 0; fi
        echo '改端口或密码会短暂重启这个运行中的节点。完成后请重新导入它的链接。'
        printf '%s\n' '1. 访问地址      2. 本地 UDP 端口' \
            '3. 公网端口映射  4. 重新生成认证和混淆密码' \
            '5. 单独更换认证或混淆密码'
        echo '6. 更换伪装网站'
        if [[ "$name" != main ]]; then echo '7. 选择 TLS 证书'; fi
        echo '0. 返回 A 区'
        read -rp '请选择要修改的设置：' choice || return 0
        case "$choice" in
            1) flag=--domain; prompt='输入已指向这台服务器的域名或 IPv4，如 hy.example.com（回车取消）：'
               if [[ "$name" == main ]]; then echo '新地址须在当前主节点证书覆盖范围内。'; fi ;;
            2) flag=--ports
               nodes_manage port-guide "$name" || { panel_pause '编辑菜单' || return 0; continue; }
               prompt='输入本地 UDP 单端口、跳跃范围、auto 或 auto:32（回车取消）：' ;;
            3) flag=--public-ports
               echo '普通 VPS 输入 same 即可。NAT 用户请照抄服务商分给你的公网 UDP 端口或范围。'
               echo '例如公网 31000 转发到本机 24443，这里填 31000。本机无法检测服务商分配了哪些端口。'
               prompt='输入 1–65535 的端口、连续范围（如 31000-31031）或 same（回车取消）：' ;;
            4)
                read -rp '替换两种密码后需重新导入客户端配置。确认？[y/N] ' value || return 0
                if [[ "${value,,}" == y ]]; then
                    nodes_manage edit "$name" --auth random --obfs random || echo '密码更新未完成。'
                    panel_pause '编辑菜单' || return 0
                fi
                continue ;;
            5)
                echo '认证密码用于登录节点；混淆密码须与客户端的 Salamander 设置一致。'
                echo '输入时屏幕不会显示字符。支持 8–128 位字母、数字和 _.@+!%*=-，需输入两次。'
                read -rp '1. 自定认证密码  2. 自定混淆密码  3. 随机认证密码  4. 随机混淆密码  0. 取消：' value || return 0
                case "$value" in
                    1) nodes_manage edit "$name" --auth custom || echo '密码更新未完成。' ;;
                    2) nodes_manage edit "$name" --obfs custom || echo '密码更新未完成。' ;;
                    3|4)
                        flag=--auth; [[ "$value" != 4 ]] || flag=--obfs
                        read -rp '确认生成新密码？旧客户端需重新导入。[y/N] ' confirm || return 0
                        [[ "${confirm,,}" == y ]] || continue
                        nodes_manage edit "$name" "$flag" random || echo '密码更新未完成。' ;;
                    *) continue ;;
                esac
                panel_pause '编辑菜单' || return 0
                continue ;;
            7) if [[ "$name" == main ]]; then echo "主节点请从 1–6 中选择。"; panel_pause "编辑菜单" || return 0; continue; fi
               echo '建议填 auto 自动选择。self 会生成带指纹的自签名证书；shared 需要主证书覆盖这个地址。'
               flag=--tls; prompt='输入 auto、self 或 shared（回车取消）：' ;;
            6) echo '伪装网站用于回应普通 HTTPS 访问。它不会改变节点地址或 WARP 规则。'
               flag=--masquerade; prompt='输入完整 HTTPS 网址，如 https://www.example.org/（回车取消）：' ;;
            0|'') return 0 ;;
            *) echo '请输入有效编号。'; panel_pause '编辑菜单' || return 0; continue ;;
        esac
        while true; do
            read -rp "$prompt" value || return 0
            [[ -n "$value" ]] || break
            read -rp "将把节点 $name 的这项设置改为 $value。确认提交？[y/N] " confirm || return 0
            [[ "${confirm,,}" == y ]] || break
            if nodes_manage edit "$name" "$flag" "$value"; then
                echo '请在A 区选 3 或 4 获取最新链接或配置。'
                panel_pause '编辑菜单' || return 0
                break
            fi
            echo '修改未完成。请按上方提示处理，或重新输入；回车返回。'
        done
    done
}

