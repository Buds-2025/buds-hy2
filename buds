warp_trace() {
    local host result reported split failed=0
    local hosts=(www.cloudflare.com)
    if warp_domain_selected chatgpt.com; then hosts+=(chatgpt.com); fi
    for host in "${hosts[@]}"; do
        split=false
        if warp_domain_selected "$host"; then split=true; fi
        if result=$(curl -q --noproxy '*' -fsS --max-time 8 "https://$host/cdn-cgi/trace") &&
            grep -q '^warp=' <<< "$result"; then
            printf '%s  ' "$host"
            awk -F= '/^(ip|loc|warp)=/ {printf "%s ", $0} END {print ""}' <<< "$result"
            reported=$(sed -n 's/^warp=//p' <<< "$result" | tr -d '\r')
            if [[ "$split" == true && "$reported" == off ]] ||
                [[ "$split" == false && "$reported" != off ]]; then
                echo "出口标记与预期不符，请检查 WARP 配置和 VPS 原有默认出口。" >&2
                failed=1
            fi
        else
            printf '%s 未返回出口诊断信息。\n' "$host"
        fi
    done
    return "$failed"
}

warp_manage() (
    local action=${1:-status} profile=${2:-} detected binary version
    if [[ "$action" == status ]]; then
        if [[ ! -d "$WARP_DIR" ]]; then echo "WARP 分流未启用。"; return 0; fi
        systemctl status "$WARP_UNIT" --no-pager
        return
    fi
    if [[ "$action" == domains || "$action" == gemini-family ]]; then
        shift
        exec 9>/run/buds-warp-split.lock && flock -x 9 || return 1
        if [[ "$action" == gemini-family ]]; then
            warp_edit_domains gemini-family "$@"
            return
        fi
        warp_edit_domains "$@"
        return
    fi
    if [[ "$action" == doctor ]]; then warp_doctor "$profile"; return; fi
    has_systemd || { echo "WARP 分流需要 systemd 和 systemd-resolved。"; return 1; }
    exec 9>/run/buds-warp-split.lock || return 1
    flock -x 9 || return 1
    case "$action" in
        setup)
            [[ -z "$profile" || "$profile" == --new-profile || "$profile" == --managed-core ]] || return 2
            warp_setup "$profile"; return ;;
        dns-switch)
            [[ ! -d "$WARP_DIR" ]] || { echo "请先运行 buds hy2 warp disable。" >&2; return 1; }
            warp_dns_switch; return ;;
        dns-restore)
            [[ ! -d "$WARP_DIR" ]] || { echo "请先运行 buds hy2 warp disable。" >&2; return 1; }
            warp_dns_restore; return ;;
        disable) warp_remove && echo "WARP 分流已关闭。" ; return ;;
        refresh)
            [[ -d "$WARP_DIR" && ! -L "$WARP_DIR" && -f "$WARP_DIR/.buds-managed" &&
                "$WARP_DIR/$WARP_UNIT" -ef "/etc/systemd/system/$WARP_UNIT" ]] ||
                { echo "无法确认托管服务归属。" >&2; return 1; }
            warp_prepare_policy files-only || return 1
            echo "已刷新启动与巡检脚本，下一次调用时生效。" ; return ;;
        check|repair)
            [[ -d "$WARP_DIR" ]] || { echo "WARP 分流未启用。" >&2; return 1; }
            if [[ "$action" == repair ]]; then
                [[ -f "$WARP_DIR/.buds-managed" && ! -L "$WARP_DIR" &&
                    "$WARP_DIR/$WARP_UNIT" -ef "/etc/systemd/system/$WARP_UNIT" ]] ||
                    { echo "无法确认 WARP 服务归属，已停止修复。" >&2; return 1; }
                warp_prepare_policy || return 1
            fi
            # 服务未运行（含重启限额停住）：清除状态后启动，启动过程由 link-up 验证隧道。
            if ! systemctl is-active --quiet "$WARP_UNIT"; then
                [[ "$action" == repair ]] || { echo "WARP 服务未运行。B 区第 14 项可修复。" >&2; return 1; }
                systemctl reset-failed "$WARP_UNIT" 2>/dev/null || true
                systemctl start "$WARP_UNIT" || {
                    echo "WARP 服务启动失败。请用 buds hy2 warp status 查看状态和启动日志。" >&2
                    return 1
                }
            fi
            if [[ -s "$WARP_DIR/domains" ]] && ! grep -Fq '"198.18.240.3/32"' "$WARP_DIR/config.json"; then
                if [[ "$action" == check ]]; then
                    echo "旧配置缺少出口探针。请在维护时段选择 B 区第 14 项更新并验证。" >&2
                    return 1
                fi
                systemctl restart "$WARP_UNIT" || return 1
                grep -Fq '"198.18.240.3/32"' "$WARP_DIR/config.json" ||
                    { echo "重载后仍缺少探针，请核对托管配置。" >&2; return 1; }
            fi
            local failed=0
            if ! warp_tunnel_probe; then
                if [[ "$action" == repair ]]; then
                    sleep 2
                    if ! warp_tunnel_probe; then
                        echo "两次 WARP 探测失败，按修复请求重新握手。" >&2
                        (cd "$WARP_DIR" && python3 -I policy.py next-port) || return 1
                        systemctl restart "$WARP_UNIT" && warp_tunnel_probe || return 1
                    fi
                else
                    failed=1
                fi
            fi
            warp_verify routes-only || failed=1
            warp_trace || failed=1
            warp_target_check || failed=1
            (( failed == 0 )) || return 1
            if [[ -s "$WARP_DIR/domains" ]]; then
                echo "分流规则和抽查的出口连通。"
                warp_gemini_check
            else
                echo "检测通过。域名清单为空，当前流量使用原有出口。"
            fi
            return ;;
        enable) ;;
        *) echo "用法：buds hy2 warp {doctor|setup [--new-profile|--managed-core]|dns-switch|dns-restore|enable [配置路径]|status|check|refresh|repair|disable|domains|gemini-family [auto|ipv4|ipv6]}"; return 2 ;;
    esac
    if [[ -d "$WARP_DIR" ]]; then
        systemctl is-active --quiet "$WARP_UNIT" && { echo "WARP 分流已启用。"; return 0; }
        echo "已有未运行的分流配置，请检查 status，或 disable 后重试。"; return 1
    fi
    warp_requirements || return 1
    [[ $(systemctl show -p LoadState --value "$WARP_UNIT") == not-found ]] ||
        { echo "$WARP_UNIT 已被占用。"; return 1; }
    detected=$(warp_find_binary) && profile=$(warp_resolve_profile "$profile") || return 1
    read -r binary version <<< "$detected"
    umask 077
    mkdir -p "$(dirname "$WARP_DIR")" && mkdir "$WARP_DIR" || return 1
    touch "$WARP_DIR/.buds-managed" || { rmdir "$WARP_DIR"; return 1; }
    trap 'rc=$?; if ((rc)); then warp_remove || echo "清理未完成，请运行 buds hy2 warp disable。" >&2; fi' EXIT
    warp_files "$profile" "$binary" "$version" || return 1
    warp_watch_links || return 1
    if ! systemctl enable "$WARP_DIR/$WARP_UNIT" "$WARP_DIR/$WARP_TIMER" || ! systemctl start "$WARP_UNIT"; then
        echo "WARP 服务启动失败。正在撤销本次启用，可用 journalctl -u $WARP_UNIT 查看原因。" >&2
        return 1
    fi
    systemctl start "$WARP_TIMER" >/dev/null 2>&1 ||
        echo "WARP 看门狗定时器未启动，可运行 systemctl start $WARP_TIMER。" >&2
    if ! { warp_verify && warp_tunnel_probe && warp_trace; }; then
        echo "选路或出口验证失败，正在撤销本次启用。" >&2
        return 1
    fi
    echo "WARP 分流已启用，当前清单选路检查通过。"
)

nodes_source() {
    cat <<'PY'
import argparse
import getpass
import grp
import ipaddress
import json
import os
import pwd
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path


BASE = Path(sys.argv[1])
PRIMARY_LISTEN, PRIMARY_PUBLIC, PRIMARY_DOMAIN = sys.argv[2:5]
ROOT = BASE / "nodes"
UNITS = Path("/etc/systemd/system")
CORE = "/usr/local/bin/hysteria"
NODE_NAME = re.compile(r"[a-z0-9][a-z0-9_-]{0,30}")
FIREWALL_PREFIX = "buds-hy2-node-"
SYSCTL_KEY = "net.ipv4.ip_local_reserved_ports"
SYSCTL_FILE = Path("/etc/sysctl.d/99-buds-hy2-reserved-ports.conf")


def run(*args, check=True):
    return subprocess.run(args, check=check, universal_newlines=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, timeout=40, env={**os.environ, "LC_ALL": "C"})


def active(unit):
    return run("systemctl", "is-active", "--quiet", unit, check=False).returncode == 0


def ports(text):
    found = re.fullmatch(r"([0-9]{1,5})(?:[-:]([0-9]{1,5}))?", text)
    if found:
        start = int(found[1])
        end = int(found[2] or found[1])
        if 1 <= start <= end <= 65535:
            return start, end
    raise ValueError(f"无效 UDP 端口或范围：{text}")


def port_text(span):
    return str(span[0]) if span[0] == span[1] else f"{span[0]}-{span[1]}"


def node_name(value):
    if not NODE_NAME.fullmatch(value) or value == "main":
        raise ValueError("节点名称须使用 1–31 位小写字母、数字、下划线或短横线，main 为主节点。")
    return value


def domain_name(value):
    try:
        value = value.rstrip(".").encode("idna").decode("ascii").lower()
    except UnicodeError:
        raise ValueError("请输入有效域名或 IPv4 地址。") from None
    try:
        address = ipaddress.ip_address(value)
        if address.version == 4:
            return str(address)
        raise ValueError("此入口请为 IPv6 主机填入域名。")
    except ValueError:
        if ":" in value:
            raise ValueError("此入口请为 IPv6 主机填入域名。")
    labels = value.split(".")
    if (len(value) > 253 or len(labels) < 2 or labels[-1].isdigit() or
            any(not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label) for label in labels)):
        raise ValueError("请输入有效域名或 IPv4 地址。")
    return value


def masquerade_url(value):
    from urllib.parse import urlsplit
    url = urlsplit(value)
    if (len(value) > 2048 or any(ch.isspace() or ord(ch) < 32 for ch in value)
            or url.scheme != "https" or not url.hostname or url.username is not None
            or url.password is not None or url.fragment):
        raise ValueError("请输入完整 HTTPS 网址，例如 https://www.example.org/，请去掉用户名、密码和 # 片段。")
    domain_name(url.hostname)
    if url.port == 0:
        raise ValueError("网址端口须为 1–65535。")
    return value


def unit_name(name):
    if name == "main":
        return "hysteria-server.service"
    return f"buds-hy2-node-{name}.service"


def load_node(path):
    if ROOT.is_symlink() or path.is_symlink() or not (path / "node.json").is_file():
        raise ValueError(f"找不到托管节点 {path.name}。")
    data = json.loads((path / "node.json").read_text())
    if data.get("name") != path.name:
        raise ValueError(f"节点记录与目录不匹配：{path.name}")
    return data


def nodes():
    if ROOT.is_symlink():
        raise ValueError("节点目录不能是符号链接。")
    if ROOT.is_dir():
        for path in sorted(ROOT.iterdir()):
            if path.is_dir() and NODE_NAME.fullmatch(path.name):
                yield load_node(path)


def listeners():
    for line in run("ss", "-H", "-uanp").stdout.splitlines():
        fields = line.split()
        if len(fields) >= 5:
            port = fields[3].rsplit(":", 1)[-1]
            if port.isdigit():
                yield int(port), set(re.findall(r"\bpid=([0-9]+)", line))


def nft_ports(value):
    if isinstance(value, int):
        yield value, value
    elif isinstance(value, dict) and "range" in value and len(value["range"]) == 2:
        if all(isinstance(n, int) for n in value["range"]):
            yield tuple(value["range"])
    elif isinstance(value, dict) and "set" in value:
        for item in value["set"]:
            yield from nft_ports(item)


def udp_redirects():
    if shutil.which("nft"):
        result = run("nft", "-j", "list", "ruleset", check=False)
        if result.returncode == 0:
            for item in json.loads(result.stdout).get("nftables", []):
                rule = item.get("rule", {})
                expressions = rule.get("expr", [])
                if not any("redirect" in expr or "dnat" in expr for expr in expressions):
                    continue
                for expr in expressions:
                    match = expr.get("match", {})
                    if match.get("op") in ("==", "in") and match.get("left", {}).get("payload") == {
                            "protocol": "udp", "field": "dport"}:
                        for span in nft_ports(match.get("right")):
                            yield span, rule.get("table", "")
    for command in ("iptables-save", "ip6tables-save"):
        if shutil.which(command):
            result = run(command, "-t", "nat", check=False)
            for line in result.stdout.splitlines():
                if " -p udp " not in line:
                    continue
                target = re.search(r" -j (DNAT|REDIRECT|HYSTERIA-PR-[a-f0-9]+)(?: |$)", line)
                match = re.search(r" --dports? ([0-9:,]+)(?: |$)", line)
                if target and match and " ! --dport" not in line:
                    for span in match[1].split(","):
                        first, separator, last = span.partition(":")
                        yield ports(f"{first or 1}-{last or 65535}" if separator else first), target[1]


def port_conflicts(name):
    if not (BASE / "config.yaml").is_file():
        raise ValueError("请先配置主节点，再新增节点。")
    primary = PRIMARY_LISTEN.partition("#")[0].strip() or "443"
    configured_public = PRIMARY_PUBLIC.partition("#")[0].strip() or primary
    reserves = [] if name == "main" else [(ports(p), "主节点监听范围") for p in primary.split(",")]
    public = [] if name == "main" else [(ports(p), "主节点公网范围") for p in configured_public.split(",")]
    own_span = ports(primary) if name == "main" else None
    for node in nodes():
        if node["name"] != name:
            reserves.append((ports(node["ports"]), node["name"]))
            public.append((ports(node["public_ports"]), node["name"]))
        else:
            own_span = ports(node["ports"])

    own_pid = run("systemctl", "show", unit_name(name), "-p", "MainPID", "--value", check=False).stdout.strip()
    for port, pids in listeners():
        if not own_pid or own_pid == "0" or pids != {own_pid}:
            reserves.append(((port, port), f"已监听 UDP {port}"))
    for span, table in udp_redirects():
        if (own_span and re.fullmatch(r"hysteria_[a-f0-9]{8}|HYSTERIA-PR-[a-f0-9]{8}", table) and
                own_span[0] < span[0] <= span[1] <= own_span[1]):
            continue
        reserves.append((span, "现有 UDP 转发规则"))
    return reserves, public


def overlaps(span, other):
    return span[0] <= other[1] and other[0] <= span[1]


def port_guide(reservations):
    first, last = 20000, 60999
    free = []
    for (start, end), _ in sorted(reservations + [((last + 1, last + 1), "")]):
        if first < start and first <= last:
            free.append((first, min(last, start - 1)))
        first = max(first, end + 1)
    print("UDP 端口可填 1–65535。单端口示例 24443；连续跳跃示例 40000-40031（也可用冒号）。")
    print("自动分配可填 auto；auto:32 表示自动选 32 个连续端口。")
    print("本机当前可选高位范围（最多列出五段）：" + ("、".join(port_text(s) for s in free[:5]) or "没有空闲段"))
    print("提交时会再次检查。云安全组须放行实际使用的 UDP 端口；NAT 服务器还需核对服务商映射。")


def choose_ports(value, reservations):
    auto = re.fullmatch(r"auto(?::([0-9]{1,3}))?", value)
    if auto:
        count = int(auto[1] or "1")
        if not 1 <= count <= 512:
            raise ValueError("自动跳跃范围长度应为 1–512。")
        first, last = 20000, 60999
        choices = []
        for (start, end), _ in sorted(reservations + [((last + 1, last + 1), "")]):
            if min(start - 1, last) - first + 1 >= count:
                choices.append((first, min(start - count, last - count + 1)))
            first = max(first, end + 1)
        candidates = sum(end - start + 1 for start, end in choices)
        if candidates:
            offset = secrets.randbelow(candidates)
            for start, end in choices:
                if offset <= end - start:
                    return start + offset, start + offset + count - 1
                offset -= end - start + 1
        raise ValueError("未找到可用端口范围，请手动指定。")
    span = ports(value)
    for used, owner in reservations:
        if overlaps(span, used):
            raise ValueError(f"端口 {port_text(span)} 与 {owner}（{port_text(used)}）重叠。")
    return span


def secret(action, previous, label):
    if action == "keep" and previous:
        return previous
    if action == "custom":
        if not sys.stdin.isatty():
            raise ValueError("输入自定义密码需要交互终端。")
        value = getpass.getpass(f"{label}（至少 8 个字符）：")
        if not re.fullmatch(r"[A-Za-z0-9_.@+!%*=-]{8,128}", value):
            raise ValueError("密码长度 8–128，支持字母、数字和 _.@+!%*=-。")
        if value != getpass.getpass(f"再次输入{label}："):
            raise ValueError("两次输入不一致。")
        return value
    return secrets.token_hex(16)


def apply_preferences(args, old):
    data = {"name": args.name}
    domain = args.domain or old.get("domain") or PRIMARY_DOMAIN
    if domain == "your.domain.com" and not args.domain:
        raise ValueError("未识别到主节点地址，请为此节点指定域名或 IPv4 地址。")
    data["domain"] = domain_name(domain)
    reserved, public = port_conflicts(args.name)
    requested = args.ports or old.get("ports") or "auto"
    # 自动选择时同时排除公网映射端口；固定端口分别核查本地监听和公网映射。
    local_span = choose_ports(requested, reserved + public if requested.startswith("auto") else reserved)
    previous_public = old.get("public_ports")
    mapped = args.public_ports or (previous_public if previous_public != old.get("ports") else None)
    public_span = choose_ports(port_text(local_span) if mapped in (None, "same") else mapped, public)
    data["ports"], data["public_ports"] = port_text(local_span), port_text(public_span)
    data["auth"] = secret(args.auth, old.get("auth"), "认证密码")
    data["obfs"] = secret(args.obfs, old.get("obfs"), "混淆密码")
    data["tls"] = args.tls or (old.get("tls") if data["domain"] == old.get("domain") else None) or "auto"
    if getattr(args, "masquerade", None) or old.get("masquerade"):
        data["masquerade"] = masquerade_url(args.masquerade or old["masquerade"])
    return data


def make_certificate(data, old, stage, path):
    domain = data["domain"]
    old_data = load_node(old) if old else {}
    if data["tls"] == "auto":
        cert = BASE / "server.crt"
        key = BASE / "server.key"
        is_ip = bool(re.fullmatch(r"[0-9.]+", domain))
        verification = run("openssl", "verify", "-purpose", "sslserver",
                           "-verify_ip" if is_ip else "-verify_hostname", domain,
                           "-untrusted", str(cert), str(cert), check=False)
        data["tls"] = "shared" if verification.returncode == 0 and key.is_file() else "self"
    if data["tls"] == "shared":
        cert, key = BASE / "server.crt", BASE / "server.key"
        verify = run("openssl", "verify", "-purpose", "sslserver",
                     "-verify_ip" if re.fullmatch(r"[0-9.]+", domain) else "-verify_hostname", domain,
                     "-untrusted", str(cert), str(cert), check=False)
        if verify.returncode or not key.is_file():
            raise ValueError("主节点的 CA 证书未覆盖此地址，或证书文件不可用。请选择自签名。")
        (stage / "server.crt").symlink_to(cert)
        return cert, key
    if old_data.get("tls") == "self" and old_data.get("domain") == domain:
        for name in ("server.crt", "server.key"):
            shutil.copyfile(old / name, stage / name)
    else:
        san = ("IP:" if re.fullmatch(r"[0-9.]+", domain) else "DNS:") + domain
        openssl_config = stage / "openssl.cnf"
        openssl_config.write_text("[req]\nprompt=no\ndistinguished_name=subject\n"
                                  "x509_extensions=extensions\n[subject]\n"
                                  f"CN={domain}\n[extensions]\nsubjectAltName={san}\n")
        run("openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:P-256",
            "-nodes", "-days", "3650", "-config", str(openssl_config),
            "-keyout", str(stage / "server.key"), "-out", str(stage / "server.crt"))
        openssl_config.unlink()
    return path / "server.crt", path / "server.key"


def check_hopping(span):
    if span[0] == span[1]:
        return
    version = run(CORE, "version").stdout
    match = re.search(r"^Version:\s*v?(\d+)\.(\d+)\.(\d+)\s*$", version, re.M)
    if not match or tuple(map(int, match.groups())) < (2, 12, 3):
        raise ValueError("新增端口跳跃需要 Hysteria 2.12.3 或更新版本，以免本机其他 UDP 流量被重定向。可先选用单端口。")
    if not (shutil.which("nft") or shutil.which("iptables")):
        raise ValueError("端口跳跃需要 nftables 或 iptables。")


def parse_spans(text):
    spans = []
    for item in text.split(","):
        item = item.strip()
        if item:
            spans.append(ports(item))
    return merge_spans(spans)


def merge_spans(spans):
    merged = []
    for start, end in sorted(set(spans)):
        if merged and start <= merged[-1][1] + 1:
            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
        else:
            merged.append((start, end))
    return merged


def subtract_spans(spans, removed):
    kept = []
    for start, end in spans:
        for r0, r1 in removed:
            if end < r0 or start > r1:
                continue
            if start < r0:
                kept.append((start, r0 - 1))
            start = max(start, r1 + 1)
        if start <= end:
            kept.append((start, end))
    return merge_spans(kept)


def spans_text(spans):
    return ",".join(f"{first}-{last}" if first != last else str(first) for first, last in spans)


def sync_reserved_ports(extra=None, primary=None):
    """先保护新旧范围，节点切换完成后再回收归属明确的端口。"""
    spans = [ports(node["ports"]) for node in nodes()]
    if (BASE / "config.yaml").is_file():
        spans.append(ports((primary or PRIMARY_LISTEN).partition("#")[0].strip() or "443"))
    if extra:
        spans.append(ports(extra))
    desired = merge_spans([span for span in spans if span[0] < span[1]])
    if SYSCTL_FILE.is_symlink():
        raise ValueError(f"请先核对符号链接 {SYSCTL_FILE}。")
    if not desired and not SYSCTL_FILE.exists():
        return
    old = SYSCTL_FILE.read_text() if SYSCTL_FILE.exists() else ""
    if old and not old.startswith("# buds-hy2"):
        raise ValueError(f"{SYSCTL_FILE} 已被其他配置占用。")
    previous = []
    if old:
        declared = re.fullmatch(r"# buds-hy2[^\n]*\n(?:# owned: ([0-9,\-]*)\n)?" +
                                re.escape(SYSCTL_KEY) + r" = ([0-9,\-]+)\n?", old)
        if not declared:
            raise ValueError(f"无法识别 {SYSCTL_FILE} 的端口记录。")
        previous = parse_spans(declared[1] if declared[1] is not None else declared[2])
    current = parse_spans(run("sysctl", "-n", SYSCTL_KEY).stdout)
    foreign = subtract_spans(current, previous)
    live = merge_spans(foreign + desired)
    owned = subtract_spans(desired, foreign)
    # sysctl 的赋值会替换整行。宿主机另有持久策略时，不与管理员争夺开机加载顺序。
    external = False
    for path in external_reservation_files():
        values = re.findall(r"^\s*-?net[./]ipv4[./]ip_local_reserved_ports\s*=([^#;\n]*)",
                            path.read_text(errors="replace"), re.M)
        if values:
            external = True
            if not old and not subtract_spans(desired, current) and all(
                    not subtract_spans(desired, parse_spans(value)) for value in values):
                continue
            raise ValueError(f"{path} 也管理源端口。请由管理员合并跳跃范围并应用，或选用单端口。")
    if external:
        return
    if desired:
        ephemeral = ports("-".join(run("sysctl", "-n", "net.ipv4.ip_local_port_range").stdout.split()))
        def available(reservations):
            return sum(end - start + 1 for start, end in subtract_spans([ephemeral], reservations))
        if not available(live) or available(live) < min(1024, available(current)):
            raise ValueError("所选范围会耗尽系统临时端口或使可用数量低于安全余量。请缩小范围或改用单端口。")
    content = (f"# buds-hy2 port hopping\n# owned: {spans_text(owned)}\n"
               f"{SYSCTL_KEY} = {spans_text(live)}\n") if desired else ""
    if live != current:
        run("sysctl", "-q", "-w", f"{SYSCTL_KEY}={spans_text(live)}")
        if parse_spans(run("sysctl", "-n", SYSCTL_KEY).stdout) != live:
            raise ValueError("源端口保留回读不一致。请核对其他网络管理程序后重试。")
    try:
        if content and old != content:
            SYSCTL_FILE.parent.mkdir(parents=True, exist_ok=True)
            atomic_text(SYSCTL_FILE, content)
        elif old and not content:
            SYSCTL_FILE.unlink()
    except OSError:
        if live != current:
            run("sysctl", "-q", "-w", f"{SYSCTL_KEY}={spans_text(current)}")
        raise
    if desired:
        print(f"已核对跳跃范围的源端口保护：{spans_text(desired)}")


def protect_new_range(requested, previous=None):
    span = ports(requested)
    if span[0] == span[1]:
        return
    sync_reserved_ports(extra=requested)
    new = subtract_spans([span], [ports(previous)] if previous else [])
    try:
        for port, _ in listeners():
            if any(start <= port <= end for start, end in new):
                raise ValueError(f"UDP {port} 已被占用。请选择其他范围。")
    except (Exception, KeyboardInterrupt):
        sync_reserved_ports()
        raise


def external_reservation_files():
    paths = [Path("/etc/sysctl.conf")]
    for directory in ("/etc/sysctl.d", "/run/sysctl.d", "/usr/local/lib/sysctl.d",
                      "/usr/lib/sysctl.d", "/lib/sysctl.d"):
        paths.extend(Path(directory).glob("*.conf"))
    return {path.resolve() for path in paths if path.is_file() and path.resolve() != SYSCTL_FILE.resolve()}


def write_files(data, old, stage, path):
    cert, key = make_certificate(data, old, stage, path)
    (stage / "node.json").write_text(json.dumps(data, indent=2) + "\n")
    (stage / "config.yaml").write_text(
        f'listen: :{data["ports"]}\n'
        f'tls:\n  cert: "{cert}"\n  key: "{key}"\n'
        f'auth:\n  type: password\n  password: "{data["auth"]}"\n'
        f'obfs:\n  type: salamander\n  salamander:\n    password: "{data["obfs"]}"\n'
        'quic:\n'
        '  initStreamReceiveWindow: 16777216\n'
        '  maxStreamReceiveWindow: 16777216\n'
        '  initConnReceiveWindow: 41943040\n'
        '  maxConnReceiveWindow: 41943040\n'
        'masquerade:\n  type: proxy\n  proxy:\n'
        f'    url: {json.dumps(data.get("masquerade", "https://news.ycombinator.com/"))}\n'
        '    rewriteHost: true\n')
    client_tls = "  insecure: false\n"
    if data["tls"] == "self":
        fingerprint = run("openssl", "x509", "-in", str(stage / "server.crt"),
                          "-noout", "-sha256", "-fingerprint").stdout.split("=", 1)[-1].strip()
        if not re.fullmatch(r"(?:[0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2}", fingerprint):
            raise ValueError("无法读取节点证书的 SHA-256 指纹。")
        client_tls = f'  insecure: true\n  pinSHA256: "{fingerprint.replace(":", "")}"\n'
    (stage / "client.yaml").write_text(
        f'server: {data["domain"]}:{data["public_ports"]}\n'
        f'auth: "{data["auth"]}"\ntls:\n  sni: {data["domain"]}\n'
        f'{client_tls}'
        f'obfs:\n  type: salamander\n  salamander:\n    password: "{data["obfs"]}"\n'
        'socks5:\n  listen: 127.0.0.1:1080\n')
    start, end = ports(data["ports"])
    caps = []
    if start < 1024:
        caps.append("CAP_NET_BIND_SERVICE")
    if start != end:
        caps.append("CAP_NET_ADMIN")
    capabilities = " ".join(caps)
    (stage / unit_name(data["name"])).write_text(f"""[Unit]
Description=Buds Hysteria 2 node {data['name']}
After=network.target buds-hysteria-egress.service

[Service]
Type=simple
ExecStart={CORE} server --config {path}/config.yaml
WorkingDirectory={path}
User=hysteria
Group=hysteria
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet={capabilities}
AmbientCapabilities={capabilities}
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
""")
    gid = grp.getgrnam("hysteria").gr_gid
    for filename in ("config.yaml", "server.crt", "server.key"):
        file = stage / filename
        if file.exists() and not file.is_symlink():
            os.chown(file, 0, gid)
            file.chmod(0o640)
    os.chown(stage, 0, gid)
    stage.chmod(0o750)


def ufw_rules():
    if not shutil.which("ufw"):
        return None
    result = run("ufw", "status", "numbered").stdout
    if "Status: active" not in result:
        return None
    for line in result.splitlines():
        match = re.fullmatch(r"\[\s*(\d+)\]\s+(\d+(?::\d+)?/udp)( \(v6\))?\s+ALLOW(?: IN)?\s+Anywhere(?: \(v6\))?\s*(?:#\s*(.*))?", line)
        if match:
            yield int(match[1]), match[2], 6 if match[3] else 4, (match[4] or "").strip()


def ufw_active():
    return bool(shutil.which("ufw")) and "Status: active" in run("ufw", "status").stdout


def firewall_port(port):
    return port.replace("-", ":") + "/udp"


def open_firewall(name, port):
    if not ufw_active():
        print(f"请确认主机防火墙和服务商面板已放行 UDP {port}。")
        return
    tag = FIREWALL_PREFIX + name
    requested = firewall_port(port)
    ufw_default = Path("/etc/default/ufw")
    ipv6 = ufw_default.is_file() and re.search(r'^\s*IPV6=["\x27]?yes', ufw_default.read_text(), re.M)
    for family, source in [(4, "0.0.0.0/0")] + ([(6, "::/0")] if ipv6 else []):
        if not any(rule == requested and f == family for _, rule, f, _ in ufw_rules()):
            run("ufw", "allow", "in", "proto", "udp", "from", source,
                "to", "any", "port", requested.split("/")[0], "comment", tag)
            if not any(rule == requested and f == family and owner == tag for _, rule, f, owner in ufw_rules()):
                raise ValueError(f"UFW 未确认 IPv{family} 入站规则 {requested}，请检查现有规则。")


def clean_firewall(name, keep=None):
    if not shutil.which("ufw"):
        return
    tag = FIREWALL_PREFIX + name
    if not ufw_active():
        if f"comment '{tag}'" in run("ufw", "show", "added").stdout:
            raise ValueError("UFW 已停用。请启用 UFW 后重试清除此节点的规则。")
        return
    for number, port, _, owner in sorted(ufw_rules(), reverse=True):
        if owner == tag and port != keep:
            run("ufw", "--force", "delete", str(number))


def unit_link(path):
    return UNITS / unit_name(path.name)


def check_unit_link(path):
    link = unit_link(path)
    if not link.is_symlink() or os.readlink(link) != str(path / link.name):
        raise ValueError(f"{unit_name(path.name)} 不属于此节点，请检查服务文件。")


def start_node(data):
    unit = unit_name(data["name"])
    port = ports(data["ports"])[0]
    run("systemctl", "start", unit)
    for _ in range(30):
        pid = run("systemctl", "show", unit, "-p", "MainPID", "--value").stdout.strip()
        if pid and pid != "0" and any(port == current and pid in pids for current, pids in listeners()):
            if active(unit):
                return
        time.sleep(0.2)
    raise ValueError(f"节点未开始监听 UDP {port}。请查看 journalctl -u {unit}。")


def add_node(args, path, data, stage):
    link = unit_link(path)
    if path.exists() or path.is_symlink() or link.exists() or link.is_symlink():
        raise ValueError(f"节点或服务已存在：{args.name}")
    stage.rename(path)
    unit = unit_name(args.name)
    try:
        link.symlink_to(path / link.name)
    except (OSError, KeyboardInterrupt):
        shutil.rmtree(path)
        raise
    try:
        run("systemctl", "daemon-reload")
        open_firewall(args.name, data["ports"])
        run("systemctl", "enable", unit)
        start_node(data)
    except (Exception, KeyboardInterrupt):
        try:
            remove_node(path)
        except Exception as error:
            raise ValueError(f"新增失败，清理中断，已保留 {args.name} 的配置以便重试删除。{error}") from error
        raise


def remove_node(path):
    unit = unit_name(path.name)
    link = unit_link(path)
    if link.exists() or link.is_symlink():
        check_unit_link(path)
        run("systemctl", "stop", unit)
        clean_firewall(path.name)
        run("systemctl", "disable", unit)
        if link.is_symlink():
            check_unit_link(path)
            link.unlink()
    else:
        run("systemctl", "daemon-reload")
        if run("systemctl", "show", unit, "-p", "LoadState", "--value", check=False).stdout.strip() != "not-found":
            raise ValueError(f"无法确认 {unit} 已移除，请检查系统服务。")
        clean_firewall(path.name)
    run("systemctl", "daemon-reload")
    shutil.rmtree(path)


def edit_node(data, old, path, stage, previous):
    check_unit_link(path)
    unit = unit_name(path.name)
    was_active = active(unit)
    if data == old:
        open_firewall(path.name, data["ports"])
        clean_firewall(path.name, firewall_port(data["ports"]))
        return
    run("systemctl", "stop", unit)
    try:
        path.rename(previous)
        stage.rename(path)
        run("systemctl", "daemon-reload")
        open_firewall(path.name, data["ports"])
        if was_active:
            start_node(data)
    except (Exception, KeyboardInterrupt):
        run("systemctl", "stop", unit)
        if previous.exists():
            if path.exists():
                path.rename(stage)
            previous.rename(path)
        run("systemctl", "daemon-reload")
        if was_active:
            start_node(old)
        clean_firewall(path.name, firewall_port(old["ports"]))
        raise
    shutil.rmtree(previous)
    clean_firewall(path.name, firewall_port(data["ports"]))


def save_node(args):
    node_name(args.name)
    path = ROOT / args.name
    old = load_node(path) if args.action == "edit" else {}
    data = apply_preferences(args, old)
    check_hopping(ports(data["ports"]))
    ROOT.mkdir(exist_ok=True)
    if ROOT.is_symlink():
        raise ValueError("节点目录不能是符号链接。")
    gid = grp.getgrnam("hysteria").gr_gid
    os.chown(ROOT, 0, gid)
    ROOT.chmod(0o750)
    work = Path(tempfile.mkdtemp(prefix=f".{args.name}-", dir=ROOT))
    stage = work / "next"
    previous = work / "previous"
    stage.mkdir()
    try:
        write_files(data, path if old else None, stage, path)
        if not old or old["ports"] != data["ports"]:
            protect_new_range(data["ports"], old.get("ports"))
        if old:
            edit_node(data, old, path, stage, previous)
        else:
            add_node(args, path, data, stage)
    except (Exception, KeyboardInterrupt):
        if not previous.exists():
            sync_reserved_ports()
        raise
    finally:
        if not previous.exists():
            shutil.rmtree(work)
        else:
            print(f"原配置保存在 {previous}，请核对服务后再清理。", file=sys.stderr)
    print(f"节点 {args.name} 已保存 · 本地 UDP {data['ports']} · 公网 UDP {data['public_ports']}")
    print(f"查看连接信息：buds hy2 nodes link {args.name}")


def patch_yaml(text, changes):
    try:
        import yaml
    except ImportError:
        raise ValueError("主节点编辑需要 PyYAML。Debian/Ubuntu 执行 apt install python3-yaml，Fedora/RHEL 执行 dnf install python3-pyyaml，Arch 执行 pacman -S python-yaml，然后重试。")
    try:
        root = yaml.compose(text, Loader=yaml.SafeLoader)
        if any(getattr(event, "anchor", None) for event in yaml.parse(text, Loader=yaml.SafeLoader)):
            raise ValueError("配置使用了 YAML 锚点，请先独立展开要修改的设置。")
    except yaml.YAMLError:
        raise ValueError("配置文件 YAML 格式异常，请先在节点菜单查看客户端配置并核对文件。") from None
    edits = []
    for keys, value in changes.items():
        node = root
        for key in keys:
            hits = [v for k, v in node.value if k.value == key] if isinstance(node, yaml.MappingNode) else []
            if len(hits) != 1:
                raise ValueError("配置缺少唯一的字段 " + ".".join(keys) + "，已停止修改。")
            node = hits[0]
        if not isinstance(node, yaml.ScalarNode):
            raise ValueError("不支持自动修改复合字段 " + ".".join(keys))
        if node.value != value:
            edits.append((node.start_mark.index, node.end_mark.index, json.dumps(value, ensure_ascii=False)))
    for start, end, value in sorted(edits, reverse=True):
        text = text[:start] + value + text[end:]
    return text


def primary_capabilities(path, span):
    text = path.read_text()
    # 仅调整本脚本模板声明的权限；其他服务文件和管理员的 drop-in 继续生效。
    for key in ("CapabilityBoundingSet", "AmbientCapabilities"):
        pattern = r"^" + key + r"=([A-Z_0-9 ]*)$"
        lines = re.findall(pattern, text, re.M)
        if len(lines) != 1:
            continue
        caps = lines[0].split()
        for cap, needed in (("CAP_NET_ADMIN", span[0] != span[1]), ("CAP_NET_BIND_SERVICE", span[0] < 1024)):
            if needed and cap not in caps:
                caps.append(cap)
            if not needed and cap in caps:
                caps.remove(cap)
        text = re.sub(pattern, key + "=" + " ".join(caps), text, flags=re.M)
    return text


def atomic_text(path, text):
    if path.is_symlink():
        raise ValueError(f"请先核对符号链接 {path}，已停止修改。")
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix="." + path.name + "-")
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
            if path.exists():
                stat = path.stat()
                os.fchown(stream.fileno(), stat.st_uid, stat.st_gid)
                os.fchmod(stream.fileno(), stat.st_mode & 0o777)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def primary_firewall(action, directory, port):
    result = run("bash", os.environ["BUDS_NODE_CLI"], "_node-firewall", action, str(directory), port)
    if result.stdout.strip():
        print(result.stdout.strip())


def edit_primary(args):
    if args.tls:
        raise ValueError("主节点证书可能被其他节点复用。请通过原证书管理方式续签，节点菜单可执行模拟续签。")
    server, client = BASE / "config.yaml", BASE / "client.yaml"
    if not server.is_file() or not client.is_file():
        raise ValueError("主节点配置不完整。请先在节点菜单查看客户端配置，生成 client.yaml。")
    if server.is_symlink() or client.is_symlink():
        raise ValueError("主节点使用外部配置链接，请在其管理工具中修改。")
    unit = unit_name("main")
    command = run("systemctl", "show", unit, "-p", "ExecStart", "--value").stdout
    if not re.search(r"argv\[\]=" + re.escape(CORE) + r" server (?:-c |--config[= ])" +
                     re.escape(str(server)) + r"(?:[ ;]|$)", command):
        raise ValueError("主节点服务未直接使用本脚本的配置文件，请先核对 systemctl cat hysteria-server。")
    local = port_text(ports(PRIMARY_LISTEN))
    public = port_text(ports(PRIMARY_PUBLIC or local))
    requested = local
    external = public
    if args.ports or args.public_ports:
        reserved, published = port_conflicts("main")
        if args.ports:
            requested = port_text(choose_ports(args.ports, reserved + published if args.ports.startswith("auto") else reserved))
            if requested != local:
                check_hopping(ports(requested))
        mapped = args.public_ports or ("same" if public == local else public)
        external = port_text(choose_ports(requested if mapped == "same" else mapped, published))
    domain = domain_name(args.domain) if args.domain else PRIMARY_DOMAIN
    if args.domain and domain != PRIMARY_DOMAIN:
        flag = "-checkip" if re.fullmatch(r"[0-9.]+", domain) else "-checkhost"
        # 某些 OpenSSL 版本的 x509 -checkhost 在不匹配时仍返回零。
        check = run("openssl", "x509", "-in", str(BASE / "server.crt"), "-noout", flag, domain)
        if "does match certificate" not in check.stdout:
            raise ValueError("当前主节点证书未覆盖新地址。请先配置覆盖该地址的证书，或新增使用独立证书的节点。")
    server_changes, client_changes = {}, {}
    if args.masquerade:
        server_changes[("masquerade", "proxy", "url")] = masquerade_url(args.masquerade)
    if requested != local:
        match = re.search(r'''^listen:\s*["']?(:[0-9]+(?:[-:][0-9]+)?)["']?\s*(?:#.*)?$''', server.read_text(), re.M)
        if not match:
            raise ValueError("主节点使用了自定义监听地址，保留原绑定；请在原配置中调整。")
        server_changes[("listen",)] = ":" + requested
    if (domain, external) != (PRIMARY_DOMAIN, public):
        client_changes[("server",)] = domain + ":" + external
    if domain != PRIMARY_DOMAIN:
        client_changes[("tls", "sni")] = domain
    for action, keys, client_keys, label in (
            (args.auth, ("auth", "password"), ("auth",), "认证密码"),
            (args.obfs, ("obfs", "salamander", "password"), ("obfs", "salamander", "password"), "混淆密码")):
        if action != "keep":
            server_changes[keys] = client_changes[client_keys] = secret(action, None, label)
    updates = {}
    for path, changes in ((server, server_changes), (client, client_changes)):
        if changes:
            updates[path] = patch_yaml(path.read_text(), changes)
    if external != public:
        updates[BASE / ".public_port"] = external + "\n"
    if requested != local:
        fragment = UNITS / unit
        if fragment.is_file() and not fragment.is_symlink():
            updates[fragment] = primary_capabilities(fragment, ports(requested))
    original = {}
    for path in list(updates):
        if path.is_symlink():
            raise ValueError(f"请先核对符号链接 {path}。")
        old = path.read_text() if path.exists() else None
        if old == updates[path]:
            del updates[path]
        else:
            original[path] = old
    if not updates:
        print("设置与当前配置相同。")
        return
    ledger = BASE / ".firewall_rule"
    if ledger.is_symlink():
        raise ValueError("防火墙记录是符号链接，请先核对。")
    registered = ledger.read_text().splitlines() if ledger.exists() else []
    work = Path(tempfile.mkdtemp(prefix=".main-edit-", dir=str(BASE)))
    pending = work / ".firewall_rule"
    touched = []
    running = active(unit)
    changed_port = local != requested
    restarting = server in updates and running
    stopped = False
    cleanup = True
    try:
        for path, old in original.items():
            if old is not None:
                (work / path.name).write_text(old)
        if changed_port:
            protect_new_range(requested, local)
            primary_firewall("open", work, requested)
        if restarting:
            run("systemctl", "stop", unit)
            stopped = True
        for path, value in updates.items():
            atomic_text(path, value)
            touched.append(path)
        if UNITS / unit in touched:
            run("systemctl", "daemon-reload")
        if restarting:
            start_node({"name": "main", "ports": requested})
        added = pending.read_text().splitlines() if pending.exists() else []
        if added:
            atomic_text(ledger, "\n".join(registered + added) + "\n")
    except (Exception, KeyboardInterrupt):
        try:
            if stopped:
                run("systemctl", "stop", unit)
            for path in reversed(touched):
                if original[path] is None:
                    path.unlink()
                else:
                    atomic_text(path, original[path])
            if UNITS / unit in touched:
                run("systemctl", "daemon-reload")
            if stopped:
                start_node({"name": "main", "ports": local})
            if pending.exists():
                primary_firewall("close", work, requested)
            if changed_port:
                sync_reserved_ports()
        except (Exception, KeyboardInterrupt):
            cleanup = False
            print(f"自动恢复未完成，原文件和防火墙记录保存在 {work}。", file=sys.stderr)
            raise
        raise
    else:
        if changed_port:
            # 仅回收安装记录中归属明确的旧 UDP 规则。网站和用户自建规则保留。
            stale = [line for line in registered if len(line.split("|")) == 4 and
                     line.split("|")[0] in ("ufw", "iptables", "firewalld") and
                     line.split("|")[-1].replace(":", "-") == local + "/udp"]
            if stale:
                pending.write_text("\n".join(stale) + "\n")
                try:
                    primary_firewall("close", work, local)
                    keep = [line for line in registered if line not in stale] + added
                    atomic_text(ledger, "".join(line + "\n" for line in keep))
                except (OSError, subprocess.SubprocessError):
                    print("新端口已保存。部分旧防火墙记录未清理，请核对 .firewall_rule。", file=sys.stderr)
            print(f"请确认服务商已放行公网 UDP {external}。管理员自行添加的旧端口规则须自行核对。")
    finally:
        if cleanup:
            shutil.rmtree(work)
    if changed_port:
        sync_reserved_ports(primary=requested)
    print(f"主节点已保存 · 本地 UDP {requested} · 公网 UDP {external}。请重新导入连接链接或客户端配置。")


def quick_add_preferences(name):
    node_name(name)
    path = ROOT / name
    link = unit_link(path)
    if path.exists() or path.is_symlink() or link.exists() or link.is_symlink():
        print(f"节点或服务已存在：{name}。请换一个名称。", file=sys.stderr)
        sys.exit(3)
    reserved, public = port_conflicts(name)
    default_domain = "" if PRIMARY_DOMAIN == "your.domain.com" else PRIMARY_DOMAIN
    hint = f"（回车沿用 {default_domain}）" if default_domain else ""
    while True:
        try:
            domain = domain_name(input(f"访问域名或 IPv4{hint}：").strip() or default_domain)
            break
        except ValueError as error:
            print(error, file=sys.stderr)

    local_main = PRIMARY_LISTEN.partition("#")[0].strip() or "443"
    public_main = PRIMARY_PUBLIC.partition("#")[0].strip() or local_main
    mapped = (BASE / ".nat-mode").is_file() or public_main.replace(":", "-") != local_main.replace(":", "-")
    port_guide(reserved + public)
    while True:
        requested = input("本地 UDP 端口（回车自动；单端口、范围或 auto:32）：").strip() or "auto"
        try:
            span = choose_ports(requested, reserved + public if requested.startswith("auto") else reserved)
            check_hopping(span)
            local = port_text(span)
            if not mapped:
                choose_ports(local, public)
            break
        except ValueError as error:
            print(error, file=sys.stderr)

    external = local
    if mapped:
        while True:
            requested = input(f"公网 UDP 端口或范围（回车使用 {local}，需在服务商处映射）：").strip() or local
            try:
                external = port_text(choose_ports(requested, public))
                break
            except ValueError as error:
                print(error, file=sys.stderr)

    return argparse.Namespace(action="add", name=name, domain=domain, ports=local,
                              public_ports=external, auth="random", obfs="random", tls=None)


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(prog="buds hy2 nodes")
    actions = parser.add_subparsers(dest="action")
    actions.add_parser("list")
    actions.add_parser("names")
    actions.add_parser("quick-add").add_argument("name")
    actions.add_parser("reserve-ports")
    actions.add_parser("prepare-install-ports").add_argument("ports")
    for verb in ("add", "edit"):
        command = actions.add_parser(verb)
        command.add_argument("name")
        command.add_argument("--domain")
        command.add_argument("--masquerade")
        command.add_argument("--ports")
        command.add_argument("--public-ports")
        command.add_argument("--auth", choices=("keep", "random", "custom"), default="keep")
        command.add_argument("--obfs", choices=("keep", "random", "custom"), default="keep")
        command.add_argument("--tls", choices=("auto", "self", "shared"))
    for verb in ("detail", "port-guide", "status", "start", "stop", "restart", "log", "delete"):
        command = actions.add_parser(verb)
        command.add_argument("name")
        if verb == "delete":
            command.add_argument("--yes", action="store_true")
    args = parser.parse_args(sys.argv[5:])
    if not args.action:
        parser.error("请选择一个多节点命令，或使用 --help 查看帮助。")
    if args.action == "prepare-install-ports":
        if (BASE / "config.yaml").exists():
            raise ValueError("已有节点配置，请使用节点菜单更改端口。")
        check_hopping(ports(args.ports))
        protect_new_range(args.ports)
        return
    if args.action == "reserve-ports":
        sync_reserved_ports()
        return
    if args.action in ("list", "names"):
        entries = list(nodes())
        if args.action == "names":
            if (BASE / "config.yaml").is_file():
                print("main")
            for data in entries:
                print(data["name"])
            return
        rows = []
        if (BASE / "config.yaml").is_file():
            state = "运行中" if active("hysteria-server.service") else "已停止"
            rows.append(("main", state, PRIMARY_LISTEN or "443", PRIMARY_PUBLIC or PRIMARY_LISTEN or "443", PRIMARY_DOMAIN))
        for data in entries:
            state = "运行中" if active(unit_name(data["name"])) else "已停止"
            rows.append((data["name"], state, data["ports"], data["public_ports"], data["domain"]))
        if not rows:
            print("尚未配置节点。")
            return
        width = max(len(row[0]) for row in rows)
        width = max(width, 4)
        print(f"{'名称':<{width - 2}}  {'状态':<4}  {'本地 UDP':<11}  {'公网 UDP':<11}  地址")
        for name, state, local, public, domain in rows:
            print(f"{name:<{width}}  {state}  {local:<13}  {public:<13}  {domain}")
        return
    if args.action == "port-guide":
        if args.name != "main":
            node_name(args.name)
        local, published = port_conflicts(args.name)
        port_guide(local + published)
        return
    if args.action == "edit" and args.name == "main":
        import signal
        def cancel(signum, frame):
            raise KeyboardInterrupt
        for signum in (signal.SIGHUP, signal.SIGTERM):
            signal.signal(signum, cancel)
        edit_primary(args)
        return
    if args.action in ("add", "edit", "quick-add"):
        if pwd.getpwnam("hysteria").pw_gid != grp.getgrnam("hysteria").gr_gid:
            raise ValueError("请检查现有 hysteria 服务账户和用户组。")
        if args.action == "quick-add":
            import fcntl
            args = quick_add_preferences(args.name)
            print("正在生成认证密码、混淆密码和证书，并启动节点…", flush=True)
            fcntl.flock(9, fcntl.LOCK_EX)
        save_node(args)
        sync_reserved_ports()
        return
    if args.name == "main":
        raise ValueError("主节点卸载和维护请使用节点区中的主节点菜单。")
    name = node_name(args.name)
    path = ROOT / name
    data = load_node(path)
    unit = unit_name(name)
    if args.action == "detail":
        print(f"{name} · {data['domain']} · 本地 UDP {data['ports']} · 公网 UDP {data['public_ports']} · TLS {data['tls']}")
        return
    if args.action == "delete":
        if not args.yes:
            raise ValueError("删除节点须加 --yes。")
        remove_node(path)
        sync_reserved_ports()
        print(f"已删除节点 {name}。")
        return
    check_unit_link(path)
    if args.action == "log":
        subprocess.run(["journalctl", "-u", unit, "-n", "50", "--no-pager"], check=True)
    elif args.action == "status":
        r = run("systemctl", "status", unit, "--no-pager", check=False)
        print(r.stdout, end="")
    elif args.action == "stop":
        run("systemctl", "stop", unit)
        print(f"已停止节点 {name}。")
    else:
        reserved, public = port_conflicts(name)
        check_hopping(choose_ports(data["ports"], reserved))
        choose_ports(data["public_ports"], public)
        open_firewall(name, data["ports"])
        if args.action == "restart":
            run("systemctl", "stop", unit)
        start_node(data)
        print(f"节点 {name} 正在运行。")


try:
    main()
except (ValueError, OSError, KeyError) as error:
    sys.exit(str(error))
except subprocess.CalledProcessError as error:
    sys.exit((error.stderr or error.stdout or "系统命令执行失败。").strip())
except subprocess.TimeoutExpired:
    sys.exit("系统命令超时，请检查节点和防火墙状态。")
except (EOFError, KeyboardInterrupt):
    sys.exit("操作已取消。")
